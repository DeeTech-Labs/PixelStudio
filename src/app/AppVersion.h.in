#ifndef PIXELSTUDIO_APP_APPVERSION_H
#define PIXELSTUDIO_APP_APPVERSION_H

#include <QString>

namespace AppVersion {

inline constexpr int kMajor = @PS_VERSION_MAJOR@;
inline constexpr int kMinor = @PS_VERSION_MINOR@;
inline constexpr int kPatch = @PS_VERSION_PATCH@;

inline QString display()
{
    QString v = QString::number(kMajor) + QLatin1Char('.')
              + QString::number(kMinor) + QLatin1Char('.')
              + QString::number(kPatch);
#if @PS_VERSION_HAS_FIX@
    v += QStringLiteral("@PS_VERSION_FIX@");
#endif
    return v;
}

inline constexpr const char *displayUtf8 = "@PS_VERSION_DISPLAY@";

} // namespace AppVersion

#endif // PIXELSTUDIO_APP_APPVERSION_H
